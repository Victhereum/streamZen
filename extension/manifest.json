{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "streamzen@victhereum.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "StreamZen: Cinematic Companion for Moviebox",
  "short_name": "StreamZen",
  "version": "1.0.2",
  "author": "Victhereum Technologies",
  "homepage_url": "https://streamzen.victhereum.com",
  "description": "Netflix-style Next Episode and Skip Intro for all Moviebox streaming platforms like123movienow, NetNaija etc",
  "icons": {
    "16": "icons/logo16.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo16.png",
      "48": "icons/logo48.png",
      "128": "icons/logo128.png"
    },
    "default_title": "StreamZen Settings"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.123movienow.cc/*",
        "*://*.moviebox.ph/*",
        "*://*.netnaija.film/*",
        "*://*.sflix.film/*",
        "*://*.movieboxonline.net/*",
        "*://*.moviebox.in/*",
        "*://*.moviebox.pk/*",
        "*://*.moviebox.id/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
