{
  "manifest_version": 3,
  "name": "StreamZen: Cinematic Companion for Moviebox",
  "version": "1.0",
  "description": "Netflix-style Next Episode and Skip Intro for all Moviebox streaming platforms like123movienow, NetNaija etc",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.123movienow.cc/*",
        "*://*.moviebox.ph/*",
        "*://*.netnaija.film/*",
        "*://*.sflix.film/*",
        "*://*.movieboxonline.net/*",
        "*://*.moviebox.in/*",
        "*://*.moviebox.pk/*",
        "*://*.moviebox.id/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
